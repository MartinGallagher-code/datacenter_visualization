"""Run dcadd straight from a checkout, with nothing installed.

The tool itself is python/dcviz/dcadd.py, so that the copy `pip install`
ships and the copy this runs are the same file. This is the two lines of
path-fixing that lets it be one file instead of two.
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "python"))

from dcviz.dcadd import main  # noqa: E402  (after the path fix, necessarily)

sys.exit(main())
