"""mos6502-export: a 6502 experiment from Modeling_2026, as viewer results.

Runs one experiment on the 6502 model in Modeling_2026
(full_stack/mos_6502) and writes what it works out as a results file for
examples/mos6502.dc -- each number on the element it is about:

  6502        CPI, IPC and MIPS of the instruction mix, priced off the
              vendor cycle table (models/isa.py), and the bus bytes each
              instruction moves (one access every cycle: bytes = CPI)
  BRD         the board's effective clock, the share of cycles the CPU
              keeps, and its bus traffic (models/board.py, models/bus.py)
  BRD-VIDEO   the cycles the video steals from the CPU (the C64's badlines)
  SYS         the model's independent checks: the Rugg/Feldman benchmark
              ratios it predicts across machines, against the published
              ones, graded at Modeling_2026's own tolerance

Nothing is computed here that the model does not compute: the mix is priced
by isa.mix_cpi, the clocks and the steal come from Mos6502Board, the bus from
Mos6502Bus, the tolerance from tier_policy.py. Every figure carries the tier
the model gives its inputs (A vendor-disclosed, B third-party measured, C
estimated), and the file carries the layout it was made for, so opening it
alone opens the chip.

usage:
  mos6502-export [--modeling PATH] [settings] [-o FILE]
  mos6502-export [--modeling PATH] [settings] --sweep NAME=V1,V2,... --out-dir DIR

settings:
  --board B         apple_ii (default), c64, bbc_micro or vic_20
  --region R        pal (default) or ntsc: the C64's and VIC-20's clock
  --mix FILE        an instruction mix, one "MNEMONIC MODE WEIGHT" a line
                    (modes as models/isa.py names them: zeropage,
                    absolute,X, (indirect),Y ...) or "branch WEIGHT";
                    weights sum to 1. Default: the model's typical mix
  --zero-page F     move the mix's zero-page and absolute memory accesses
                    so a fraction F of them use zero page, as the model's
                    zero-page sweep does
  --page-cross F    the share of indexed reads that cross a page (+1 cycle);
                    default 0.10
  --branch-taken F  the share of branches taken; default 0.6
  --no-overlap      without the overlapped next-opcode fetch: the model's
                    counterfactual, one more cycle an instruction
  --screen on|off   C64: the screen on (default) or blanked
  --sprites N       C64: sprites on every raster line (the model's worst
                    case), 0 to 8; default 0

  --sweep NAME=V1,V2,...  one experiment a value of one setting (board,
                    region, zero-page, page-cross, branch-taken, screen or
                    sprites), each written to its own file in --out-dir,
                    with a table of them on the standard output
  --layout PATH     the layout to carry in the file; default the
                    repository's examples/mos6502.dc
  --no-layout       carry none

The checkout is --modeling or $MODELING_2026: a clone of
MartinGallagher-code/Modeling_2026, or its full_stack/mos_6502 directory.
"""

import argparse
import datetime
import hashlib
import os
import re
import subprocess
import sys
from pathlib import Path

TOOL = "mos6502-export"
HERE = Path(__file__).resolve().parent
DEFAULT_LAYOUT = HERE.parent / "examples" / "mos6502.dc"

BOARDS = {
    "apple_ii": ("Apple II", "master_clock_hz"),
    "c64": ("Commodore 64", "clock_hz_{region}"),
    "bbc_micro": ("BBC Micro", "clock_mhz"),
    "vic_20": ("VIC-20", "clock_mhz_{region}"),
}
REGIONAL = ("c64", "vic_20")
SWEEPABLE = ("board", "region", "zero-page", "page-cross", "branch-taken", "screen", "sprites")

TESTS = [
    ("cpu_cpi", 'unit=cycles decimals=3 higher=bad short=CPI label="cycles per instruction"'),
    ("cpu_ipc", 'decimals=3 higher=good short=IPC label="instructions per cycle"'),
    ("cpu_mips", 'unit=MIPS decimals=3 higher=good short=MIPS label="million instructions a second, at the effective clock"'),
    ("cpu_bus_bytes_per_instr", 'unit=B decimals=2 short=B/I label="bus bytes per instruction (an access every cycle)"'),
    ("board_effective_mhz", 'unit=MHz decimals=4 higher=good short=MHz label="effective CPU clock"'),
    ("board_cpu_share_pct", 'unit=% decimals=1 higher=good min=0 max=100 short=CPU% label="cycles the CPU keeps"'),
    ("board_cpu_bus_mbps", 'unit=Mb/s decimals=3 short=BUS label="the CPU\'s bus traffic"'),
    ("board_machine", 'short=BRD label="machine"'),
    ("video_steal_pct", 'unit=% decimals=2 higher=bad min=0 short=VID label="cycles the video steals from the CPU"'),
    ("holdout_c64_vic20_residual_pct", 'unit=% decimals=2 higher=bad min=0 short=H1 '
     'label="C64 vs VIC-20 benchmark ratio, predicted vs published"'),
    ("holdout_c64_vic20", 'short=H1 label="C64 vs VIC-20 holdout"'),
    ("holdout_apple_vic20_residual_pct", 'unit=% decimals=2 higher=bad min=0 short=H2 '
     'label="Apple II vs VIC-20 benchmark ratio, predicted vs published"'),
    ("holdout_apple_vic20", 'short=H2 label="Apple II vs VIC-20 holdout"'),
]


class Refused(Exception):
    """A setting or input this tool will not guess its way past."""


# ---------------------------------------------------------------- the model

class Model:
    """The pieces of Modeling_2026's 6502 package this tool reads."""

    def __init__(self, path):
        pkg = self.locate(path)
        self.pkg = pkg
        sys.path.insert(0, str(pkg))
        try:
            from models import isa
            from models._topo import topology
            from models.board import Mos6502Board
            from models.bus import Mos6502Bus
            from models.core import Mos6502Core
            import tier_policy
        except ImportError as e:
            raise Refused(f"{pkg} does not have the 6502 model this tool reads ({e})")
        self.isa = isa
        self.topology = topology()
        self.board = Mos6502Board()
        self.bus = Mos6502Bus()
        self.core = Mos6502Core()
        self.tolerance = tier_policy.BENCHMARK_RATIO_TOL

    @staticmethod
    def locate(path):
        if not path:
            raise Refused("no Modeling_2026 checkout: pass --modeling PATH (a clone of "
                          "MartinGallagher-code/Modeling_2026) or set MODELING_2026")
        p = Path(path).expanduser()
        for pkg in (p / "full_stack" / "mos_6502", p):
            if (pkg / "models" / "isa.py").is_file() and (pkg / "tier_policy.py").is_file():
                return pkg.resolve()
        raise Refused(f"{p} is not a Modeling_2026 checkout: no full_stack/mos_6502/models/isa.py in it")

    def commit(self):
        """The checkout's commit, and whether the 6502 package has changes not committed."""
        def git(*args):
            r = subprocess.run(["git", "-C", str(self.pkg), *args], capture_output=True, text=True)
            return r.stdout.strip() if r.returncode == 0 else ""
        sha = git("rev-parse", "--short", "HEAD")
        if not sha:
            return "unknown (not a git checkout)"
        return f"{sha} (with changes not committed)" if git("status", "--porcelain", "--", ".") else sha

    def tier(self, *keys):
        node = self.topology
        for k in keys:
            node = node.get(k) if isinstance(node, dict) else None
        return node.get("_tier", "?") if isinstance(node, dict) else "?"


# ---------------------------------------------------------------- the mix

def read_mix(path, isa):
    """An instruction mix from a file: (mnemonic, mode) -> weight, or 'branch'."""
    mix = {}
    try:
        text = Path(path).read_text()
    except OSError as e:
        raise Refused(f"cannot read the mix {path}: {e.strerror}")
    for n, raw in enumerate(text.splitlines(), 1):
        line = raw.split("#", 1)[0].split()
        if not line:
            continue
        where = f"{path}:{n}"
        if line[0].lower() == "branch" and len(line) == 2:
            key, weight = "branch", line[1]
        elif len(line) == 3:
            key, weight = (line[0].upper(), line[1]), line[2]
            try:
                isa.cycles_for(*key)
            except KeyError:
                raise Refused(f"{where}: {key[0]} {key[1]} is not in the cycle table "
                              "(modes as models/isa.py names them: implied, immediate, zeropage, absolute,X ...)")
        else:
            raise Refused(f"{where}: expected 'MNEMONIC MODE WEIGHT' or 'branch WEIGHT', not {raw.strip()!r}")
        try:
            w = float(weight)
        except ValueError:
            raise Refused(f"{where}: the weight {weight!r} is not a number")
        if not w >= 0:
            raise Refused(f"{where}: a weight cannot be negative")
        if key in mix:
            raise Refused(f"{where}: {key if key == 'branch' else ' '.join(key)} is given twice")
        mix[key] = w
    total = sum(mix.values())
    if not mix:
        raise Refused(f"{path} has no mix in it")
    if abs(total - 1.0) > 1e-3:
        raise Refused(f"{path}: the weights sum to {total:g}; they must sum to 1")
    return mix


def zero_page_mix(mix, fraction):
    """The model's zero-page sweep (simulations/instruction_mix_cpi.py), at
    any fraction: the zero-page and absolute LDA/STA weight, moved so that
    `fraction` of it is zero page."""
    rows = [("LDA", "zeropage"), ("STA", "zeropage"), ("LDA", "absolute"), ("STA", "absolute")]
    if not all(r in mix for r in rows):
        raise Refused("--zero-page moves LDA and STA between zeropage and absolute, "
                      "so the mix needs all four rows")
    out = dict(mix)
    total = sum(out.pop(r) for r in rows)
    out[("LDA", "zeropage")] = total * fraction
    out[("LDA", "absolute")] = total * (1.0 - fraction)
    return out


# ---------------------------------------------------------------- one experiment

def experiment(model, s):
    """What the model says for one set of settings, as {metric: (target, value, tags)}."""
    board = s["board"]
    mix = model.isa.TYPICAL_MIX if s["mix"] is None else s["mix_rows"]
    if s["zero_page"] is not None:
        mix = zero_page_mix(mix, s["zero_page"])
    cpi = model.isa.mix_cpi(mix, page_cross_rate=s["page_cross"], branch_taken_fraction=s["branch_taken"])
    if not s["overlap"]:
        o = model.core.overlap_counterfactual()
        cpi += o["cpi_without_overlap"] - o["cpi_with_overlap"]

    b = model.board
    if board == "c64":
        steal = b.c64_steal_fraction(s["region"], s["screen"], s["sprites"])
        effective = b.c64_effective_mhz(s["region"], screen_on=False) * (1.0 - steal)
        steal_tier = model.tier("boards", "c64", "badline_stolen_cycles")
    else:
        steal = 1.0 - b.availability(board, s["region"])
        effective = b.effective_mhz(board, s["region"])
    clock_tier = model.tier("boards", board, BOARDS[board][1].format(region=s["region"]))
    if board != "c64":
        steal_tier = clock_tier   # no steal, by the board's design: the same sources as its clock
    mix_tier = "C" if s["mix"] is None else "input"

    holdouts = {"c64_vic20": b.holdout_c64_vic20(), "apple_vic20": b.holdout_apple_vic20()}
    bench_tier = model.tier("benchmarks", "c64_basic_v2")

    mix_tag = {"mix": "typical" if s["mix"] is None else Path(s["mix"]).name, "tier": mix_tier}
    out = {
        "cpu_cpi": ("6502", cpi, mix_tag),
        "cpu_ipc": ("6502", 1.0 / cpi, mix_tag),
        "cpu_mips": ("6502", effective / cpi, mix_tag),
        "cpu_bus_bytes_per_instr": ("6502", model.bus.bytes_per_instruction(cpi), mix_tag),
        "board_effective_mhz": ("BRD", effective, {"tier": clock_tier}),
        "board_cpu_share_pct": ("BRD", 100.0 * (1.0 - steal), {"tier": steal_tier}),
        "board_cpu_bus_mbps": ("BRD", model.bus.bandwidth_bytes_per_s(effective) * 8 / 1e6, {"tier": clock_tier}),
        "board_machine": ("BRD", BOARDS[board][0], {}),
        "video_steal_pct": ("BRD-VIDEO", 100.0 * steal, {"tier": steal_tier}),
    }
    for name, h in holdouts.items():
        ok = h["residual"] <= model.tolerance
        tags = {"predicted": f"{h['predicted']:.5f}", "measured": f"{h['measured']:.5f}",
                "tolerance_pct": f"{100 * model.tolerance:g}", "tier": bench_tier}
        out[f"holdout_{name}_residual_pct"] = ("SYS", 100.0 * h["residual"], tags)
        out[f"holdout_{name}"] = ("SYS", "PASS" if ok else "FAIL", tags)
    return out


def label_of(s):
    parts = [s["board"]]
    if s["board"] in REGIONAL:
        parts.append(s["region"])
    parts.append("typical" if s["mix"] is None else Path(s["mix"]).stem)
    if s["zero_page"] is not None:
        parts.append(f"zp{s['zero_page']:g}")
    if s["page_cross"] != 0.10:
        parts.append(f"pc{s['page_cross']:g}")
    if s["branch_taken"] != 0.6:
        parts.append(f"bt{s['branch_taken']:g}")
    if not s["overlap"]:
        parts.append("no-overlap")
    if s["board"] == "c64" and not s["screen"]:
        parts.append("screen-off")
    if s["board"] == "c64" and s["sprites"]:
        parts.append(f"sprites{s['sprites']}")
    return "-".join(parts)


def fmt(v):
    """A value or tag as the results reader takes it: one with a space or a comma, quoted."""
    v = v if isinstance(v, str) else f"{v:.6g}"
    return '"' + v.replace('"', "'") + '"' if re.search(r'[\s,"]', v) else v


def results_file(model, s, numbers, layout):
    """The experiment as a results file: comments, !test lines, samples, stamps."""
    label = label_of(s)
    lines = [
        f"# {TOOL}: a 6502 experiment from Modeling_2026, for examples/mos6502.dc -- {label}",
        f"# The model: Modeling_2026 full_stack/mos_6502 @ {model.commit()}. The mix is priced off the vendor",
        "# cycle table (models/isa.py, Tier A); the typical mix itself is the model's estimate (Tier C).",
        "# Clocks and the video steal: models/board.py; bus traffic: models/bus.py; the holdouts are the",
        f"# model's independent checks, graded at tier_policy.BENCHMARK_RATIO_TOL ({100 * model.tolerance:g}%).",
        "# tier= on each sample: A vendor-disclosed, B third-party measured, C estimated, input = your mix.",
    ]
    lines += [f"!test\t{name}\t{meta}" for name, meta in TESTS]
    for name, _ in TESTS:
        target, value, tags = numbers[name]
        extra = "".join(f"\t{k}={fmt(v)}" for k, v in tags.items())
        lines.append(f"{name}\t{target}\t{fmt(value)}\trun={fmt(label)}{extra}")
    made = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    stamp = {"made": made, "tool": TOOL, "modeling_2026": model.commit(), "board": s["board"],
             "mix": "typical" if s["mix"] is None else s["mix"],
             "page_cross": f"{s['page_cross']:g}", "branch_taken": f"{s['branch_taken']:g}",
             "overlap": "yes" if s["overlap"] else "no"}
    if s["board"] in REGIONAL:
        stamp["region"] = s["region"]
    if s["zero_page"] is not None:
        stamp["zero_page"] = f"{s['zero_page']:g}"
    if s["board"] == "c64":
        stamp["screen"] = "on" if s["screen"] else "off"
        stamp["sprites"] = str(s["sprites"])
    lines += [f"#~run {k} {one_line(v)}" for k, v in stamp.items()]
    if layout is not None:
        lines.append(model_block(*layout))
    return "\n".join(lines) + "\n"


def one_line(v):
    return re.sub(r"\s+", " ", str(v)).strip()


def model_block(name, text):
    """The layout as #~ lines, exactly as the viewer's stamp.js writes and checks them."""
    text = text.replace("\r\n", "\n").replace("\r", "\n")
    text = (text[:-1] if text.endswith("\n") else text) + "\n"
    body = text[:-1].split("\n")
    sha = hashlib.sha256(text.encode("utf-8")).hexdigest()
    return "\n".join([f"#~model sha256={sha} lines={len(body)} name={name}",
                      *[f"#~ {line}" if line else "#~" for line in body], "#~end model"])


# ---------------------------------------------------------------- command line

def fraction(text):
    try:
        v = float(text)
    except ValueError:
        raise argparse.ArgumentTypeError(f"{text!r} is not a number")
    if not 0.0 <= v <= 1.0:
        raise argparse.ArgumentTypeError(f"{text} is not a fraction from 0 to 1")
    return v


def sprites(text):
    try:
        v = int(text)
    except ValueError:
        raise argparse.ArgumentTypeError(f"{text!r} is not a whole number")
    if not 0 <= v <= 8:
        raise argparse.ArgumentTypeError("the VIC-II has 8 sprites: 0 to 8")
    return v


def screen(text):
    t = text.lower()
    if t not in ("on", "off"):
        raise argparse.ArgumentTypeError("on or off")
    return t == "on"


def board(text):
    t = text.lower().replace("-", "_")
    t = {"apple": "apple_ii", "appleii": "apple_ii", "bbc": "bbc_micro", "vic20": "vic_20"}.get(t, t)
    if t not in BOARDS:
        raise argparse.ArgumentTypeError(f"{text!r}: one of {', '.join(BOARDS)}")
    return t


def region(text):
    t = text.lower()
    if t not in ("pal", "ntsc"):
        raise argparse.ArgumentTypeError("pal or ntsc")
    return t


PARSE = {"board": board, "region": region, "zero-page": fraction, "page-cross": fraction,
         "branch-taken": fraction, "screen": screen, "sprites": sprites}


def usage():
    print(__doc__[__doc__.index("usage:"):].rstrip())


def main(argv=None):
    ap = argparse.ArgumentParser(prog=TOOL, add_help=False)
    ap.add_argument("-h", "--help", action="store_true")
    ap.add_argument("--modeling", default=os.environ.get("MODELING_2026"))
    ap.add_argument("--board", type=board, default="apple_ii")
    ap.add_argument("--region", type=region, default="pal")
    ap.add_argument("--mix")
    ap.add_argument("--zero-page", type=fraction)
    ap.add_argument("--page-cross", type=fraction, default=0.10)
    ap.add_argument("--branch-taken", type=fraction, default=0.6)
    ap.add_argument("--no-overlap", action="store_true")
    ap.add_argument("--screen", type=screen)
    ap.add_argument("--sprites", type=sprites)
    ap.add_argument("--sweep")
    ap.add_argument("--out-dir")
    ap.add_argument("--layout", default=str(DEFAULT_LAYOUT))
    ap.add_argument("--no-layout", action="store_true")
    ap.add_argument("-o", "--output")
    a = ap.parse_args(argv)
    if a.help:
        usage()
        return 0
    try:
        return run(a)
    except Refused as e:
        print(f"{TOOL}: {e}", file=sys.stderr)
        return 2


def run(a):
    settings = {"board": a.board, "region": a.region, "mix": a.mix, "zero_page": a.zero_page,
                "page_cross": a.page_cross, "branch_taken": a.branch_taken, "overlap": not a.no_overlap,
                "screen": True if a.screen is None else a.screen, "sprites": a.sprites or 0}
    sweep = None
    if a.sweep:
        name, _, values = a.sweep.partition("=")
        name = name.strip().lower()
        if name not in SWEEPABLE or not values:
            raise Refused(f"--sweep NAME=V1,V2,...: NAME is one of {', '.join(SWEEPABLE)}")
        try:
            sweep = (name, [PARSE[name](v.strip()) for v in values.split(",") if v.strip()])
        except argparse.ArgumentTypeError as e:
            raise Refused(f"--sweep {name}: {e}")
        if not a.out_dir:
            raise Refused("--sweep writes a file an experiment: give the directory with --out-dir")
        if a.output:
            raise Refused("--sweep writes into --out-dir; -o is for one experiment")
    elif a.out_dir:
        raise Refused("--out-dir is for --sweep; -o FILE writes one experiment")

    c64_only = [flag for flag, v in (("--screen", a.screen), ("--sprites", a.sprites)) if v is not None]
    boards = sweep[1] if sweep and sweep[0] == "board" else [a.board]
    if c64_only and any(b != "c64" for b in boards):
        raise Refused(f"{' and '.join(c64_only)} {'apply' if len(c64_only) > 1 else 'applies'} to the C64 only")
    if sweep and sweep[0] in ("screen", "sprites") and a.board != "c64":
        raise Refused(f"--sweep {sweep[0]} applies to the C64 only: add --board c64")

    layout = None
    if not a.no_layout:
        try:
            layout = (Path(a.layout).name, Path(a.layout).read_text())
        except OSError as e:
            raise Refused(f"cannot read the layout {a.layout}: {e.strerror} (or pass --no-layout)")

    model = Model(a.modeling)
    if a.mix:
        settings["mix_rows"] = read_mix(a.mix, model.isa)

    if not sweep:
        numbers = experiment(model, settings)
        text = results_file(model, settings, numbers, layout)
        if a.output:
            Path(a.output).write_text(text)
            print(f"{a.output}: {summary(settings, numbers)}", file=sys.stderr)
        else:
            sys.stdout.write(text)
        return 0

    name, values = sweep
    out = Path(a.out_dir)
    out.mkdir(parents=True, exist_ok=True)
    key = name.replace("-", "_")
    rows = []
    for v in values:
        s = dict(settings, **{key: v})
        numbers = experiment(model, s)
        path = out / f"{label_of(s)}.tsv"
        path.write_text(results_file(model, s, numbers, layout))
        rows.append((v, numbers, path))
    print(f"{name:>12}  {'CPI':>6}  {'IPC':>6}  {'MIPS':>6}  {'MHz':>7}  {'CPU %':>6}  file")
    for v, n, path in rows:
        shown = v if isinstance(v, str) else ("on" if v is True else "off" if v is False else f"{v:g}")
        print(f"{shown:>12}  {n['cpu_cpi'][1]:6.3f}  {n['cpu_ipc'][1]:6.3f}  {n['cpu_mips'][1]:6.3f}  "
              f"{n['board_effective_mhz'][1]:7.4f}  {n['board_cpu_share_pct'][1]:6.2f}  {path}")
    return 0


def summary(s, n):
    return (f"{label_of(s)}: CPI {n['cpu_cpi'][1]:.3f}, IPC {n['cpu_ipc'][1]:.3f}, "
            f"{n['cpu_mips'][1]:.3f} MIPS at {n['board_effective_mhz'][1]:.4f} MHz")


if __name__ == "__main__":
    sys.exit(main())
